  },
  {
    "id": "ada-w1",
    "metin": "Pofi çayırda hazine sandığını arıyor. Çarpımları bilirsen yol açılır!",
    "kategori": "ada"
  },
  {
    "id": "bolum-w1-l1",
    "metin": "Bir kere bir, hep bir!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w1-l2",
    "metin": "İkişer ikişer sayalım.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w1-l3",
    "metin": "Üçer üçer zıplayalım.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w1-l4",
    "metin": "İki tablo karıştı, dikkat!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w1-l5",
    "metin": "Süre başlıyor, hızlı ol!",
    "kategori": "bolum"
  },
  {
    "id": "ada-w2",
    "metin": "Ormanın şekilleri karıştı! 4 ve 5 çarpımlarıyla onları yerlerine koy.",
    "kategori": "ada"
  },
  {
    "id": "bolum-w2-l1",
    "metin": "Dört ayaklı dostlar 4'er sayıyor.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w2-l2",
    "metin": "Beşer beşer yukarı!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w2-l3",
    "metin": "Şekilleri doğru sepete sürükle.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w2-l4",
    "metin": "Kare, dikdörtgen, üçgen, daire!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w2-l5",
    "metin": "Üç tablo bir arada.",
    "kategori": "bolum"
  },
  {
    "id": "ada-w3",
    "metin": "Kristaller kenar ve köşe sayıyor. Sayabilir misin?",
    "kategori": "ada"
  },
  {
    "id": "bolum-w3-l1",
    "metin": "Kaç kenarı var?",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w3-l2",
    "metin": "Kaç köşesi var?",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w3-l3",
    "metin": "Karışık sorular geliyor!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w3-l4",
    "metin": "Beşgen, altıgen ve daire!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w3-l5",
    "metin": "Kristal canavar uyandı!",
    "kategori": "bolum"
  },
  {
    "id": "ada-w4",
    "metin": "Sihirli kalemle şekilleri çiz, köprüyü tamamla!",
    "kategori": "ada"
  },
  {
    "id": "bolum-w4-l1",
    "metin": "Dört eşit kenar çiz.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l2",
    "metin": "Uzun ve kısa kenarlar.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l3",
    "metin": "Üç kenar birleşir.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l4",
    "metin": "Yuvarlak ve pürüzsüz.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l5",
    "metin": "Beş kenar, beş köşe.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l6",
    "metin": "Altı kenar, altı köşe.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l7",
    "metin": "Kare ve dikdörtgeni arka arkaya çiz.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l8",
    "metin": "Köşeli ve yuvarlak şekil.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w4-l9",
    "metin": "Altı şekli arka arkaya çiz — usta ol!",
    "kategori": "bolum"
  },
  {
    "id": "ada-w5",
    "metin": "Ejderha hazineyi koruyor. Bildiklerini kullan ve kaleyi kazan!",
    "kategori": "ada"
  },
  {
    "id": "bolum-w5-l1",
    "metin": "Hızlı cevap ver!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w5-l2",
    "metin": "Kenar ve köşe yağmuru!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w5-l3",
    "metin": "3 × ? = 12 — eksik sayıyı bul.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w5-l4",
    "metin": "? × 4 = 20 — baştaki sayı kaç?",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w5-l5",
    "metin": "Her şey karıştı, son sınav!",
    "kategori": "bolum"
  },
  {
    "id": "ada-w6",
    "metin": "Büyük sayılar diyarı! 6, 7, 8, 9 ve 10’lar burada. Yıldızı hak et!",
    "kategori": "ada"
  },
  {
    "id": "bolum-w6-l1",
    "metin": "Altışar altışar yükseliyoruz.",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w6-l2",
    "metin": "Yediler en zorudur, cesaret!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w6-l3",
    "metin": "Sekizer sekizer, iki kere iki kere iki!",
    "kategori": "bolum"
  },
  {
    "id": "bolum-w6-l4",
    "metin": "Dokuzların hilesi: on katı eksi bir katı.",
