  },
  {
    "id": "geri-1",
    "metin": "Çok yakın, biraz daha devam et.",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-2",
    "metin": "Şeklin üzerinden geç.",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-3",
    "metin": "Tekrar dene, noktaları takip et.",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-4",
    "metin": "Doğru! Süpersin!",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-5",
    "metin": "Aferin!",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-6",
    "metin": "Şimdi sıra sende! Aynı şekilde çiz.",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-7",
    "metin": "Süper, beş doğru üst üste!",
    "kategori": "geri-bildirim"
  },
  {
    "id": "geri-8",
    "metin": "Dersler. Bir şekil seç, önce öğren sonra çiz.",
